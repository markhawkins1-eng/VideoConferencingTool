# Copy to .env and fill in. Never commit .env.

# Public hostname (DNS A/AAAA record pointing at this server).
DOMAIN=call.example.com
# This server's public IPv4 address (coturn advertises it in relay candidates).
PUBLIC_IP=203.0.113.10

# Shared secret between the app and coturn. Generate with:  openssl rand -hex 32
TURN_SECRET=

# Optional: Prometheus metrics at /metrics (Authorization: Bearer <token>).
# METRICS_TOKEN=

# Optional: send all media through TURN so neither side learns the other's IP address.
# ICE_TRANSPORT_POLICY=relay

# Email invites (omit SMTP_HOST to offer only "Use my email app").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Private Call <invites@example.com>
